{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MNQ Realtime Dashboard",
  "version": "0.1.0",
  "identifier": "com.quantfutures.mnqdashboard",
  "build": {
    "beforeDevCommand": "npm --prefix ../dashboard_ui run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../dashboard_ui run build",
    "frontendDist": "../../dashboard_ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MNQ Realtime Dashboard",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "additionalBrowserArgs": "--enable-unsafe-webgpu --enable-features=Vulkan,UseSkiaRenderer"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 ws://127.0.0.1:8765 http://tauri.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis"
  }
}
